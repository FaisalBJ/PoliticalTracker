# ─── QUORUM BACKEND CONFIG ────────────────────────────────────────────────────
#
# Copy this file to .env for local development.
# No API keys required — all data sources are official government disclosures.

# Server port (default: 3000)
PORT=3000

# Cache TTL in milliseconds (default: 5 minutes = 300000)
CACHE_TTL_MS=300000

# How many days of historical trades to load (default: 90)
LOOKBACK_DAYS=90

# Max number of individual XML filings to fetch per refresh cycle (default: 60)
# Lower this if refreshes are too slow; raise it for more trade coverage.
MAX_FILINGS=60
