# ─── QUORUM BACKEND CONFIG ────────────────────────────────────────────────────
#
# Copy this file to .env and fill in your keys.
# The app works WITHOUT any API keys — congressional data is public domain.
# Adding the Aletheia key supplements the feed with SEC Form 4 insider trades.

# Server port (default: 3000)
PORT=3000

# Aletheia API key (optional)
# Get yours free at: https://aletheiaapi.com/
# Without this key, only congressional STOCK Act data is shown.
ALETHEIA_API_KEY=

# Cache TTL in milliseconds (default: 5 minutes = 300000)
CACHE_TTL_MS=300000

# How many days of historical trades to load (default: 90)
LOOKBACK_DAYS=90
